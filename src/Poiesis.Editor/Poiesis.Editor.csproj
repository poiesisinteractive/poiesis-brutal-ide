<Project Sdk="Microsoft.NET.Sdk">

  <!-- L'IDE : fenêtre GLFW, viewport Vulkan, interface Dear ImGui (branche docking). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Poiesis.Editor</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Poiesis.Editor.Core\Poiesis.Editor.Core.csproj" />
    <ProjectReference Include="..\Poiesis.Render\Poiesis.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.Brutal.Glfw" />
    <PackageReference Include="Ahwoo.Brutal.ImGui" />
    <PackageReference Include="Ahwoo.Brutal.ImGui.Backends" />
    <PackageReference Include="Ahwoo.Brutal.ImGui.Extensions" />
    <PackageReference Include="Ahwoo.Brutal.ImGui.FreeType" />
  </ItemGroup>

  <!-- Logo BRUTAL (splash, À propos) et NOTICE.txt : obligations de la BRUTAL License v1.0, sections 2.2 et 2.3. -->
  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets" />
    <None Include="Assets\BRUTAL-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" Link="NOTICE.txt" />
  </ItemGroup>

</Project>
